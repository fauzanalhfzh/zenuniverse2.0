        {
          "type": "frame",
          "id": "pow88",
          "name": "Programming languages / marquee",
          "context": "Marquee implementation: repeat the eight-language sequence for a seamless leftward loop at a slow readable speed. Pause on hover and keyboard focus. Respect prefers-reduced-motion by showing a static wrapping list. Canvas shows a static preview, not active animation.",
          "clip": true,
          "width": "fill_container",
          "fill": "$white",
          "stroke": "$slate-200",
          "strokeWidth": {
            "top": 2,
            "bottom": 2
          },
          "padding": [
            24,
            40
