              ]
            },
            {
              "type": "frame",
              "id": "s8toBQ",
              "name": "Mobile about story",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 18,
              "children": [
                {
                  "type": "text",
                  "id": "Ot2r4",
                  "name": "Mobile about paragraph one",
                  "fill": "$slate-600",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Di awal masa kuliah, kami punya pertanyaan yang sama: mulai belajar dari mana, dan sama siapa? Materi sains, coding, dan teknologi tersebar di mana-mana.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "rXNtn",
                  "name": "Mobile about paragraph two",
                  "fill": "$slate-600",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Dari kebingungan itu, Zenuniverse lahir. Sebuah ruang yang hangat dan terbuka, karena ilmu lebih bermakna ketika dibagikan dan belajar lebih seru ketika bersama.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "aK1ex",
                  "name": "Mobile about closing",
                  "fill": "$slate-700",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Selama masih ada yang penasaran, perjalanan ini terus berlanjut.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "600"
                }
              ]
            }
          ]
        },
