          "children": [
            {
              "type": "frame",
              "id": "P9k9m2",
              "name": "Mobile about intro",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "YBgCz",
                  "name": "Mobile about eyebrow",
                  "fill": "$indigo-700",
                  "content": "Dari komunitas, untuk yang penasaran.",
                  "fontFamily": "$font-body",
                  "fontSize": 13,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "NUUQk",
                  "name": "Mobile about headline",
                  "fill": "$primary-dark",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Lahir dari kebingungan. Tumbuh dari kebersamaan.",
                  "lineHeight": 1.14,
                  "fontFamily": "$font-display",
                  "fontSize": 32,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "C8ITh",
                  "name": "Mobile about quote",
                  "fill": "$slate-700",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "“Kenapa kita nggak ciptakan aja ruangnya, tempat untuk berkumpul dan berbagi ilmu?”",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "u2Z3S",
              "name": "Mobile community gallery",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "frame",
                  "id": "p26tBx",
                  "name": "Mobile gallery main",
                  "width": "fill_container",
                  "height": 184,
                  "fill": {
                    "type": "image",
                    "enabled": true,
                    "url": "zenuniverse-assets/banner-2.webp",
                    "mode": "fill"
                  },
                  "cornerRadius": 14
                },
                {
                  "type": "frame",
